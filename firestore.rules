rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // SupMag n'a pas encore de couche d'authentification (pas de firebase_auth
    // dans l'app) : l'accès est donc ouvert pour permettre à l'app de lire et
    // écrire ses données. À restreindre dès qu'une authentification est ajoutée.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
